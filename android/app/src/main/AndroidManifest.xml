<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- F6B (C80): the camera, for QR scanning only. Asked for when Scan is
         pressed, never at launch; frames are decoded on the device and none
         is kept. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- A phone without a camera can still install Lume: Scan says scanning
         is unavailable, and From gallery still reads a code. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false"
        tools:replace="android:required" />
    <!-- The camera plugin declares the microphone for video recording. Lume
         records no video and no sound. -->
    <uses-permission
        android:name="android.permission.RECORD_AUDIO"
        tools:node="remove" />
    <!-- F6B: Save image writes through MediaStore, which needs no permission
         from Android 10 (API 29). Only Android 6–9 need storage access to add
         one picture, and it is asked when Save image is pressed. Never
         MANAGE_EXTERNAL_STORAGE, never a read permission. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- The manifest merger implies READ_EXTERNAL_STORAGE from the camera
         plugin's WRITE_EXTERNAL_STORAGE. Nothing in Lume reads storage: the
         Photo Picker grants the one image chosen. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
    <!-- F6B closure: androidx.media3:media3-common 1.9.0 declares this,
         reached through camera_android_camerax -> androidx.camera:camera-video
         1.6.2 -> media3-container. It serves a media player's bandwidth
         estimate; Lume records no video and plays none, and nothing it runs
         asks what network the phone is on. -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <application
        android:label="lume"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- D6: Emergency asks whether a dialer exists before handing it a
             number (url_launcher canLaunchUrl on Android 11+). Opening the
             dialer needs no permission; nothing here can place a call. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
